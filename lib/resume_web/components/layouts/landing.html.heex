<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content={
        assigns[:meta_description] ||
          "Talk about your career and get a tailored resume for every job. Free AI resume builder with voice input and 20+ professional templates."
      }
    />
    <link rel="canonical" href={assigns[:canonical_url] || url(~p"/")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Spiel" />
    <meta property="og:title" content={assigns[:page_title] || "Spiel"} />
    <meta
      property="og:description"
      content={
        assigns[:meta_description] ||
          "Talk about your career and get a tailored resume for every job. Free AI resume builder with voice input and 20+ professional templates."
      }
    />
    <meta property="og:url" content={assigns[:canonical_url] || url(~p"/")} />
    <meta
      property="og:image"
      content={assigns[:og_image] || url(~p"/images/landing/resume.webp")}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={assigns[:page_title] || "Spiel"} />
    <meta
      name="twitter:description"
      content={
        assigns[:meta_description] ||
          "Talk about your career and get a tailored resume for every job. Free AI resume builder with voice input and 20+ professional templates."
      }
    />
    <meta
      name="twitter:image"
      content={assigns[:og_image] || url(~p"/images/landing/resume.webp")}
    />
    <.live_title default="Spiel">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lora:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        window.setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
      })();
    </script>
  </head>
  <body>
    <nav class="navbar bg-transparent absolute top-0 left-0 right-0 z-50 px-4 sm:px-6 lg:px-8">
      <div class="flex-1">
        <a href="/" class="btn btn-ghost text-lg font-semibold font-serif">Spiel</a>
      </div>
      <div class="flex-none flex items-center gap-2">
        <Layouts.theme_toggle />
        <.link href={~p"/users/log-in"} class="btn btn-ghost btn-sm">Log in</.link>
        <.link href={~p"/users/register"} class="btn btn-primary btn-sm">Get Started</.link>
      </div>
    </nav>

    {@inner_content}

    <footer class="footer footer-center bg-base-100 border-t border-base-300 text-base-content p-6">
      <aside>
        <p class="font-semibold text-lg">Spiel</p>
        <p>Talk about your career. Get a resume.</p>
        <nav class="flex gap-4 text-sm">
          <a href="/templates" class="link link-hover">Templates</a>
          <a href="/privacy" class="link link-hover">Privacy</a>
          <a href="/terms" class="link link-hover">Terms</a>
        </nav>
        <p class="text-sm text-base-content/60">
          &copy; {DateTime.utc_now().year} Spiel. All rights reserved.
        </p>
      </aside>
    </footer>
  </body>
</html>
