<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Spiel">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" type="image/x-icon" href={~p"/favicon.ico"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lora:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        window.setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
      })();
    </script>
  </head>
  <body>
    <nav class="navbar bg-base-100 border-b border-base-300 px-4 sm:px-6 lg:px-8">
      <div class="flex-1">
        <a
          href={if @current_scope, do: ~p"/home", else: "/"}
          class="btn btn-ghost text-lg font-semibold font-serif"
        >
          Spiel
        </a>
      </div>
      <div class="flex-none flex items-center gap-2">
        <%= if @current_scope do %>
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-1">
              <.icon name="hero-user-circle-micro" class="size-5" />
              <span class="hidden sm:inline text-sm">
                {user_display_name(@current_scope.user)}
              </span>
              <.icon name="hero-chevron-down-micro" class="size-3 opacity-60" />
            </div>
            <ul
              tabindex="0"
              class="dropdown-content menu bg-base-200 rounded-box z-20 w-52 p-2 shadow-lg border border-base-300"
            >
              <li class="menu-title flex flex-row items-center justify-between px-2">
                <span>Theme</span>
                <Layouts.theme_toggle />
              </li>
              <li><.link href={~p"/profile"}>Profile</.link></li>
              <li><.link href={~p"/users/settings"}>Account</.link></li>
              <li><.link href={~p"/billing"}>Billing</.link></li>
              <li><a href="mailto:support@giveyourspiel.app">Feedback</a></li>
              <%= if Resume.Accounts.User.admin?(@current_scope.user) do %>
                <li class="border-t border-base-300 mt-1 pt-1">
                  <.link href={~p"/admin"} class="text-warning">
                    <.icon name="hero-shield-check-micro" class="size-4" /> Admin
                  </.link>
                </li>
              <% end %>
              <li class="border-t border-base-300 mt-1 pt-1">
                <.link href={~p"/users/log-out"} method="delete">Log out</.link>
              </li>
            </ul>
          </div>
        <% else %>
          <Layouts.theme_toggle />
          <.link href={~p"/users/register"} class="btn btn-ghost btn-sm">Register</.link>
          <.link href={~p"/users/log-in"} class="btn btn-primary btn-sm">Log in</.link>
        <% end %>
      </div>
    </nav>
    {@inner_content}
    <footer class="footer footer-center bg-base-100 border-t border-base-300 text-base-content p-6">
      <aside>
        <nav class="flex gap-4 text-sm">
          <a href="/privacy" class="link link-hover">Privacy</a>
          <a href="/terms" class="link link-hover">Terms</a>
        </nav>
        <p class="text-sm text-base-content/60">
          &copy; {DateTime.utc_now().year} Spiel. All rights reserved.
        </p>
      </aside>
    </footer>
  </body>
</html>
