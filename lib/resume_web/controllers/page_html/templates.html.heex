<section class="py-24 px-4 bg-base-100">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-medium tracking-tight mb-4">Professional Resume Templates</h1>
      <p class="text-lg text-base-content/60 max-w-2xl mx-auto">
        Choose from over 20 free, professionally designed templates.
        Each one works with Spiel's AI to produce a polished, tailored resume in minutes.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <div :for={{name, key} <- @templates} class="space-y-2">
        <div
          class="rounded-lg overflow-hidden border border-base-300 shadow-sm hover:shadow-md transition-shadow"
          style="container-type: inline-size;"
        >
          <div class="relative w-full aspect-[8.5/11] overflow-hidden bg-white">
            <iframe
              srcdoc={@previews[key]}
              class="absolute top-0 left-0 w-[8.5in] h-[11in] origin-top-left pointer-events-none"
              style="transform: scale(calc(100cqi / 816px));"
              scrolling="no"
              tabindex="-1"
              title={"#{name} resume template preview"}
            />
          </div>
        </div>
        <p class="text-center font-medium">{name}</p>
      </div>
    </div>

    <div class="text-center mt-16 space-y-4">
      <h2 class="text-2xl font-medium tracking-tight">Ready to build yours?</h2>
      <p class="text-base-content/60">
        Tell your story once and get a tailored resume for every job — completely free.
      </p>
      <.link href={~p"/users/register"} class="btn btn-primary btn-lg">
        Get Started Free
      </.link>
    </div>
  </div>
</section>
