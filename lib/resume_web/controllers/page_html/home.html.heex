<%!-- Hero Section --%>
<section class="hero min-h-screen bg-base-200">
  <div class="hero-content flex-col lg:flex-row-reverse gap-12 py-24 px-4 max-w-7xl mx-auto">
    <div class="w-full lg:w-3/5">
      <img
        src={~p"/images/landing/resume.webp"}
        alt="A polished resume generated by Spiel"
        class="rounded-2xl shadow-2xl w-full"
      />
    </div>
    <div class="max-w-xl lg:w-2/5 shrink-0">
      <h1 class="text-5xl font-medium tracking-tight leading-tight">
        Talk about your career. Get a resume for every job.
      </h1>
      <p class="py-6 text-lg text-base-content/70">
        Tell your story once. Spiel learns your experience, then generates a
        tailored resume and cover letter for every job you apply to — so each
        application puts your best foot forward.
      </p>
      <div class="flex flex-wrap gap-4">
        <.link href={~p"/users/register"} class="btn btn-primary btn-lg">
          Get Started Free
        </.link>
        <a href="#how-it-works" class="btn btn-ghost btn-lg">
          See how it works
        </a>
      </div>
    </div>
  </div>
</section>

<%!-- How It Works --%>
<section id="how-it-works" class="py-24 px-4 bg-base-100">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-semibold tracking-tight text-center mb-4">How it works</h2>
    <p class="text-center text-base-content/60 mb-16 max-w-2xl mx-auto">
      Three simple steps from conversation to completed resume.
    </p>

    <div class="grid md:grid-cols-3 gap-12">
      <div class="text-center space-y-4">
        <div class="bg-base-200 rounded-full w-16 h-16 flex items-center justify-center mx-auto">
          <.icon name="hero-microphone" class="size-8 text-primary" />
        </div>
        <h3 class="text-xl font-semibold">1. Tell your story</h3>
        <p class="text-base-content/60">
          Record yourself talking about your work history, skills, and accomplishments. No writing required.
        </p>
        <img
          src={~p"/images/landing/onboarding.webp"}
          alt="Onboarding interview where Spiel asks about your career"
          loading="lazy"
          class="rounded-xl shadow-lg"
        />
      </div>

      <div class="text-center space-y-4">
        <div class="bg-base-200 rounded-full w-16 h-16 flex items-center justify-center mx-auto">
          <.icon name="hero-document-text" class="size-8 text-primary" />
        </div>
        <h3 class="text-xl font-semibold">2. Paste a job description</h3>
        <p class="text-base-content/60">
          Drop in a job posting URL or paste the description. Spiel generates a resume tailored to what that employer is looking for.
        </p>
        <img
          src={~p"/images/landing/generation.webp"}
          alt="Generating a tailored resume from a job description"
          loading="lazy"
          class="rounded-xl shadow-lg"
        />
      </div>

      <div class="text-center space-y-4">
        <div class="bg-base-200 rounded-full w-16 h-16 flex items-center justify-center mx-auto">
          <.icon name="hero-chat-bubble-left-right" class="size-8 text-primary" />
        </div>
        <h3 class="text-xl font-semibold">3. Refine through feedback</h3>
        <p class="text-base-content/60">
          Not quite right? Have a follow-up conversation to adjust wording, add details, or tailor for a specific role.
        </p>
        <img
          src={~p"/images/landing/refinement.webp"}
          alt="Refining a resume with natural language feedback"
          loading="lazy"
          class="rounded-xl shadow-lg"
        />
      </div>
    </div>
  </div>
</section>

<%!-- Why It Matters --%>
<section class="py-24 px-4 bg-base-200">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-3xl font-semibold tracking-tight mb-4">
      Tailored resumes get more interviews
    </h2>
    <p class="text-base-content/60 max-w-2xl mx-auto mb-16">
      Most applicants send the same resume everywhere. Employers — and their AI screening
      tools — notice. A resume matched to the job description is far more likely to pass
      automated filters and land on a human's desk.
    </p>

    <div class="grid sm:grid-cols-3 gap-8">
      <div class="card bg-base-100 border border-base-300">
        <div class="card-body items-center">
          <span class="text-5xl font-bold text-primary">2-3x</span>
          <p class="text-base-content/60">more interview requests with a tailored resume</p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body items-center">
          <span class="text-5xl font-bold text-primary">63%</span>
          <p class="text-base-content/60">of recruiters prefer resumes tailored to the role</p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body items-center">
          <span class="text-5xl font-bold text-primary">54%</span>
          <p class="text-base-content/60">
            of applicants never tailor — stand out from the crowd
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<%!-- Features --%>
<section class="py-24 px-4 bg-base-100">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-semibold tracking-tight text-center mb-4">Everything you need</h2>
    <p class="text-center text-base-content/60 mb-16 max-w-2xl mx-auto">
      Built to make resume creation as effortless as having a conversation.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="card bg-base-100 border border-base-300">
        <div class="card-body">
          <.icon name="hero-briefcase" class="size-8 text-primary" />
          <h3 class="card-title mt-2">Tailored to each role</h3>
          <p class="text-base-content/60">
            Paste a job posting and get a resume that highlights the experience that matters most for that specific role.
          </p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body">
          <.icon name="hero-microphone" class="size-8 text-primary" />
          <h3 class="card-title mt-2">Voice input</h3>
          <p class="text-base-content/60">
            Speak naturally about your experience. No typing, no templates to fill out.
          </p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body">
          <.icon name="hero-arrow-path" class="size-8 text-primary" />
          <h3 class="card-title mt-2">Easy revisions</h3>
          <p class="text-base-content/60">
            New job posting? A new tailored resume in seconds. Your career profile carries over so you never start from scratch.
          </p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body">
          <.icon name="hero-chat-bubble-left-right" class="size-8 text-primary" />
          <h3 class="card-title mt-2">Conversational refinement</h3>
          <p class="text-base-content/60">
            Iterate on your resume with natural follow-up conversations until it's perfect.
          </p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body">
          <.icon name="hero-envelope" class="size-8 text-primary" />
          <h3 class="card-title mt-2">Matching cover letters</h3>
          <p class="text-base-content/60">
            Generate a tailored cover letter that complements your resume and speaks directly to the job posting.
          </p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body">
          <.icon name="hero-document-duplicate" class="size-8 text-primary" />
          <h3 class="card-title mt-2">Multiple templates</h3>
          <p class="text-base-content/60">
            Choose from professional resume and cover letter designs that highlight your strengths.
          </p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body">
          <.icon name="hero-arrow-down-tray" class="size-8 text-primary" />
          <h3 class="card-title mt-2">PDF export</h3>
          <p class="text-base-content/60">
            Download polished PDFs of your resume and cover letter, ready to send to employers.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<%!-- Final CTA --%>
<section class="py-24 px-4 bg-base-200">
  <div class="max-w-2xl mx-auto text-center space-y-6">
    <h2 class="text-4xl font-medium tracking-tight">Ready to give your spiel?</h2>
    <p class="text-lg text-base-content/60">
      Your next application deserves more than a generic resume. Tell your story once, then get a tailored resume and cover letter for every role.
    </p>
    <.link href={~p"/users/register"} class="btn btn-primary btn-lg">
      Get Started Free
    </.link>
  </div>
</section>
