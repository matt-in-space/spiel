<Layouts.app flash={@flash}>
  <div class="text-center space-y-6">
    <h1 class="text-4xl font-bold">Spiel</h1>
    <p class="text-lg text-base-content/70">
      Voice-first resume builder. Talk about your experience — get a polished resume.
    </p>
    <div class="flex justify-center gap-4 mt-8">
      <.link href={~p"/users/register"} class="btn btn-primary">Get Started</.link>
      <.link href={~p"/users/log-in"} class="btn btn-ghost">Log in</.link>
    </div>
  </div>
</Layouts.app>
